{
    "name": "ParcelFlow Backend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nest build",
        "dev": "cross-env NODE_ENV=dev nest start --watch",
        "stage": "cross-env NODE_ENV=stage node dist/main.js",
        "prod": "cross-env NODE_ENV=prod node --max-old-space-size=10240 dist/main.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.958.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/static": "^10.1.6",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/common": "^11.1.16",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.16",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mongoose": "^11.0.4",
        "@nestjs/platform-fastify": "^11.1.28",
        "@nestjs/platform-socket.io": "^11.1.19",
        "@nestjs/schedule": "^12.0.2",
        "@nestjs/serve-static": "^5.0.5",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/websockets": "^11.1.19",
        "@socket.io/redis-adapter": "^8.3.0",
        "axios": "^1.13.2",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "cloudinary": "^2.11.0",
        "cross-env": "^7.0.3",
        "eslint-config-prettier": "^10.1.8",
        "fastify": "^5.11.3",
        "ioredis": "^5.10.1",
        "mongoose": "^8.20.0",
        "morgan": "^1.10.1",
        "nodemailer": "^9.0.5",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "stripe": "^22.5.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@nestjs/schematics": "^11.1.0",
        "@types/bcrypt": "^6.0.0",
        "@types/morgan": "^1.9.10",
        "@types/nodemailer": "^8.0.1",
        "eslint": "^9.18.0",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "prettier": "^3.4.2",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.0"
    }
}
